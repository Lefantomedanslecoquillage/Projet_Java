<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.school.smartenergy.controller.MainController">

    <left>
        <VBox styleClass="sidebar" spacing="10" style="-fx-padding: 20; -fx-min-width: 180;">
            <Label text="Smart Energy" styleClass="sidebar-title" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
            <Separator/>
            <Button text="Tableau de bord" onAction="#showDashboard" maxWidth="Infinity"/>
            <Button text="Bâtiments"       onAction="#showBuildings"   maxWidth="Infinity"/>
            <Button text="Consommations"   onAction="#showConsumptions" maxWidth="Infinity"/>
            <Button text="Graphiques"      onAction="#showCharts"      maxWidth="Infinity"/>
            <Button text="Analyse"         onAction="#showAnalysis"    maxWidth="Infinity"/>
            <Button text="Paramètres"      onAction="#showSettings"    maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <BorderPane fx:id="rootPane"/>
    </center>

</BorderPane>
